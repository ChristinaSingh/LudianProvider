<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_5sdp"
        android:orientation="vertical"
        android:background="@drawable/rounded_white_25bg"
        android:elevation="@dimen/_10sdp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:orientation="horizontal">


            <ImageView
                android:id="@+id/ivClose"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:padding="@dimen/_2sdp"
                android:src="@drawable/ic_cross" />


        </LinearLayout>


      <TextView
          android:id="@+id/tvDate"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="20 June"
          android:layout_margin="@dimen/_10sdp"
          android:fontFamily="@font/poppins_medium"
          android:textSize="@dimen/_13sdp"
          android:textColor="@color/black"
          android:layout_gravity="center_horizontal"
          />



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_45sdp"
            android:layout_marginStart="@dimen/_25sdp"
            android:layout_marginEnd="@dimen/_25sdp"
            android:weightSum="1"
            android:background="@drawable/rounded_gray_bg"
            android:padding="@dimen/_8sdp"
            android:elevation="@dimen/_5sdp">



            <TextView
                android:id="@+id/tvForbidden"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight=".5"
                android:text="@string/forbidden"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                />

            <TextView
                android:id="@+id/tvNightAvailability"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight=".5"
                android:text="@string/night_availability"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                />



        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_25sdp"
            android:layout_marginEnd="@dimen/_25sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:gravity="center_horizontal"
            android:padding="@dimen/_8sdp">



            <ImageView
                android:id="@+id/ivEdit"
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:src="@drawable/ic_brown_edit"
                android:layout_marginEnd="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_7sdp"/>

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAR 1200"
                android:fontFamily="@font/poppins_bold"
                android:textSize="@dimen/_16sdp"
                android:textColor="@color/black"
                />




        </LinearLayout>





        <RelativeLayout
            android:id="@+id/btnAddNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_15sdp"
            android:layout_marginBottom="@dimen/_15sdp"
            android:alpha=".8"
            android:padding="@dimen/_10sdp"
            android:background="@drawable/rounded_brown_btn_bg"
            >

            <ImageView
                android:id="@+id/ivEditNote"
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:src="@drawable/ic_brown_edit"
                android:layout_marginEnd="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_toEndOf="@+id/tvNote"
                app:tint="@color/white"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/poppins_regular"
                android:text=""
                android:textColor="@color/white"
                android:textSize="@dimen/_16sdp" />



        </RelativeLayout>


<!--
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAddNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_15sdp"
            android:layout_marginBtotom="@dimen/_15sdp"
            android:alpha=".8"
            android:background="@drawable/rounded_brown_btn_bg"
            android:fontFamily="@font/poppins_regular"
            android:padding="@dimen/_10sdp"
            android:text="@string/add_a_note"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/_12sdp" />
-->



    </LinearLayout>
</layout>
