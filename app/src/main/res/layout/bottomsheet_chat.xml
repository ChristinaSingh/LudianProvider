<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ic_chat_bg"
        android:padding="@dimen/_5sdp">


        <RelativeLayout
            android:id="@+id/rlHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_10sdp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivImg"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:src="@drawable/ic_dummy"
                    />


                <LinearLayout
                    android:layout_toEndOf="@+id/ivImg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:orientation="vertical"
                    android:layout_centerInParent="true"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_black_light"
                        android:textSize="@dimen/_14sdp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Emelie"
                        />






                </LinearLayout>



            <ImageView
                android:id="@+id/ivCall"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:src="@drawable/ic_call"
                android:layout_alignParentEnd="true"
                android:layout_centerInParent="true"
                />




        </RelativeLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChatList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rlHeader"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_above="@+id/rlFooter"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            />


        <RelativeLayout
            android:id="@+id/rlFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_7sdp"
            android:layout_marginEnd="@dimen/_7sdp"
            android:layout_alignParentBottom="true">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_white_gray_bg"
                android:layout_toStartOf="@+id/btnAudio"
                >

                <EditText
                    android:id="@+id/edMsg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_regular"
                    android:padding="@dimen/_10sdp"
                    android:singleLine="true"
                    android:hint="@string/your_message"
                    android:gravity="center_vertical"
                    android:elevation="@dimen/_5sdp"
                    android:background="@null"
                    android:layout_toStartOf="@+id/ivVector"/>



                <ImageView
                    android:id="@+id/ivVector"
                    android:layout_width="@dimen/_17sdp"
                    android:layout_height="@dimen/_17sdp"
                    android:src="@drawable/ic_vactor"
                    android:layout_alignParentEnd="true"
                    android:layout_centerInParent="true"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:layout_marginStart="@dimen/_7sdp"/>



            </RelativeLayout>



            <RelativeLayout
                android:id="@+id/btnAudio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_white_gray_bg"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="@dimen/_15sdp"
                android:padding="@dimen/_9sdp"
                android:layout_centerInParent="true"
                >

                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/ic_voice"
                    android:layout_centerInParent="true"/>


            </RelativeLayout>


        </RelativeLayout>



    </RelativeLayout>
</layout>
