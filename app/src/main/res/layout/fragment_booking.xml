<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

<androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_black_light"
            android:textSize="@dimen/_16sdp"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/booking"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginStart="@dimen/_15sdp"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_45sdp"
            android:layout_marginStart="@dimen/_18sdp"
            android:layout_marginEnd="@dimen/_18sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:weightSum="1"
            android:background="@drawable/rounded_gray_bg"
            android:padding="@dimen/_8sdp"
            android:elevation="@dimen/_5sdp"
            android:visibility="gone">



            <TextView
                android:id="@+id/tvForbidden"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight=".5"
                android:text="@string/latest_reservation"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                />

            <TextView
                android:id="@+id/tvNightAvailability"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight=".5"
                android:text="@string/next_guest"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                />



        </LinearLayout>



        <androidx.cardview.widget.CardView
            android:id="@+id/searchBar"
            android:layout_below="@+id/ivHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/_10sdp"
            android:layout_margin="@dimen/_18sdp"
            app:cardElevation="@dimen/_5sdp">


<!--
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_10sdp">

                <ImageView
                    android:id="@+id/ivSearch"
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:src="@drawable/ic_search"/>


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/ivSearch"
                    android:text="@string/search"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="@dimen/_12sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:textColor="@color/black_light"/>




            </RelativeLayout>
-->

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_10sdp">

                <ImageView
                    android:id="@+id/ivSearch"
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:src="@drawable/ic_search"/>


                <EditText
                    android:id="@+id/edSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/ivSearch"
                    android:hint="@string/search"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="@dimen/_12sdp"
                    android:background="@null"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:textColor="@color/black_light"/>





            </RelativeLayout>

        </androidx.cardview.widget.CardView>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_18sdp"
            android:layout_marginEnd="@dimen/_18sdp">

            <LinearLayout
                android:id="@+id/llUpcoming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"
                    android:textColor="@color/black"
                    android:text="@string/in_progres"/>

                   <View
                       android:id="@+id/view1"
                       android:layout_marginTop="@dimen/_3sdp"
                       android:layout_width="@dimen/_40sdp"
                       android:layout_height="@dimen/_2sdp"
                       android:background="@drawable/rounded_blue5_bg"/>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/llPrevious"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_centerInParent="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"
                    android:textColor="@color/black"
                    android:text="@string/completed"/>

                <View
                    android:id="@+id/view2"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_2sdp"
                    android:background="@drawable/rounded_green5_bg"/>


            </LinearLayout>

            <LinearLayout
                android:id="@+id/llCancelled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentEnd="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="@dimen/_11sdp"
                    android:textColor="@color/black"
                    android:text="@string/cancelled"/>

                <View
                    android:id="@+id/view3"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_2sdp"
                    android:background="@drawable/rounded_red5_bg"/>


            </LinearLayout>



        </RelativeLayout>




        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBooking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10sdp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_booking" />


            <TextView
                android:id="@+id/tvNotFound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_black_light"
                android:textSize="@dimen/_14sdp"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/data_not_available"
                android:layout_centerHorizontal="true"
                android:visibility="gone"
                android:layout_margin="@dimen/_60sdp"
                />
        </RelativeLayout>



    </LinearLayout>





</androidx.core.widget.NestedScrollView>




</layout>
