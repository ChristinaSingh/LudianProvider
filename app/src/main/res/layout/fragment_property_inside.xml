<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">



    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">



        <RelativeLayout
            android:id="@+id/rlHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/_10sdp"
            >


            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:src="@drawable/ic_brown_back"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginStart="@dimen/_5sdp"/>


















        </RelativeLayout>

        <LinearLayout
            android:layout_below="@+id/rlHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_15sdp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lets_started_basic"
                android:fontFamily="@font/poppins_bold"
                android:layout_gravity="center_vertical"
                android:textSize="@dimen/_16sdp"
                android:textColor="@color/black"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add_more_details"
                android:fontFamily="@font/poppins_regular"
                android:layout_gravity="center_vertical"
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/color_gray_light1"
                />



            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_white_gray_bg"
                android:layout_marginTop="@dimen/_15sdp"
                android:orientation="vertical"
                >


                <TextView
                    android:id="@+id/tvBedrooms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bedrooms"
                    android:textSize="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/color_gray_light1"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    />


                <TextView
                    android:id="@+id/tvBedroomCount"
                    android:layout_below="@+id/tvBedrooms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_regular"
                    android:padding="@dimen/_10sdp"
                    android:layout_marginTop="-15dp"
                    android:singleLine="true"
                    android:gravity="center_vertical"
                    android:elevation="@dimen/_5sdp"
                    android:layout_marginStart="@dimen/_2sdp"
                    android:background="@null"
                    android:layout_toStartOf="@+id/llEnd"
                    android:text="0"
                    />

                <LinearLayout
                    android:id="@+id/llEnd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_centerInParent="true"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivMinus1"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_minus" />


                    <TextView
                        android:id="@+id/tvCount1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="0"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_14sdp" />


                    <ImageView
                        android:id="@+id/ivPlus1"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/i_plus" />


                </LinearLayout>





            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_white_gray_bg"
                android:layout_marginTop="@dimen/_15sdp"
                android:orientation="vertical"
                >


                <TextView
                    android:id="@+id/tvBed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/beds"
                    android:textSize="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/color_gray_light1"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    />


                <TextView
                    android:id="@+id/tvBedCount"
                    android:layout_below="@+id/tvBed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_regular"
                    android:padding="@dimen/_10sdp"
                    android:layout_marginTop="-15dp"
                    android:singleLine="true"
                    android:gravity="center_vertical"
                    android:elevation="@dimen/_5sdp"
                    android:layout_marginStart="@dimen/_2sdp"
                    android:background="@null"
                    android:layout_toStartOf="@+id/llEnd2"
                    android:text="0"
                    />

                <LinearLayout
                    android:id="@+id/llEnd2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_centerInParent="true"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivMinus2"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_minus" />


                    <TextView
                        android:id="@+id/tvCount2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="0"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_14sdp" />


                    <ImageView
                        android:id="@+id/ivPlus2"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/i_plus" />


                </LinearLayout>





            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_white_gray_bg"
                android:layout_marginTop="@dimen/_15sdp"
                android:orientation="vertical"
                >


                <TextView
                    android:id="@+id/tvBathrooms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bathrooms"
                    android:textSize="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/color_gray_light1"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    />


                <TextView
                    android:id="@+id/tvBathroomCount"
                    android:layout_below="@+id/tvBathrooms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10sdp"
                    android:fontFamily="@font/poppins_regular"
                    android:padding="@dimen/_10sdp"
                    android:layout_marginTop="-15dp"
                    android:singleLine="true"
                    android:gravity="center_vertical"
                    android:elevation="@dimen/_5sdp"
                    android:layout_marginStart="@dimen/_2sdp"
                    android:background="@null"
                    android:layout_toStartOf="@+id/llEnd3"
                    android:text="0"
                    />

                <LinearLayout
                    android:id="@+id/llEnd3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_centerInParent="true"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivMinus3"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_minus" />


                    <TextView
                        android:id="@+id/tvCount3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="0"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_14sdp" />


                    <ImageView
                        android:id="@+id/ivPlus3"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/i_plus" />


                </LinearLayout>





            </RelativeLayout>




        </LinearLayout>


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_brown_btn_bg"
            android:fontFamily="@font/poppins_regular"
            android:padding="@dimen/_10sdp"
            android:text="@string/next"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/_12sdp"
            android:layout_margin="@dimen/_12sdp"
            android:layout_alignParentBottom="true"
            />



    </RelativeLayout>



</layout>
