<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <RelativeLayout
        android:id="@+id/rlMain"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_80sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:background="@drawable/rounded_gray_white10_bg">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toEndOf="@+id/tvDiscount"
            android:layout_toStartOf="@+id/ivImg"
            android:orientation="vertical"
            android:layout_marginEnd="@dimen/_10sdp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/a_room"
                android:layout_gravity="center_vertical"
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/color_gray_light7"/>


            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:fontFamily="@font/poppins_regular"
                android:layout_gravity="center_vertical"
                android:text="@string/guest_have_their_own_room"
                android:textSize="@dimen/_10sdp"
                android:textColor="@color/color_gray_light7"/>



        </LinearLayout>


        <TextView
            android:id="@+id/tvDiscount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/_15sdp"
            android:textSize="@dimen/_16sdp"
            android:text="20%"
            android:fontFamily="@font/poppins_regular"
            />



        <ImageView
            android:id="@+id/ivImg"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_alignParentEnd="true"
            android:layout_centerInParent="true"
            android:layout_marginEnd="@dimen/_15sdp"
            android:src="@drawable/custom_checkbox" />



    </RelativeLayout>

</layout>
